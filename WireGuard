import tkinter as tk
import subprocess

# WireGuard 설정 파일 경로
wg_config_path = r'C:\Program Files\WireGuard\wg0.conf\project.conf'  # 설정 파일 경로

def connect_wireguard():
    try:
        # wg.exe 명령어로 WireGuard 연결
        subprocess.run([r'C:\Program Files\WireGuard\wireguard.exe', 'quick', 'up', 'wg0'], check=True)
        print("WireGuard 연결 성공")
    except subprocess.CalledProcessError as e:
        print(f"WireGuard 연결 실패: {e}")

# Tkinter GUI 설정
root = tk.Tk()
root.title("WireGuard 연결")

# 버튼 생성
connect_button = tk.Button(root, text="WireGuard 연결", command=connect_wireguard)
connect_button.pack(pady=20)

# GUI 실행
root.mainloop()


